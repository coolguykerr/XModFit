#!/bin/sh
# Refuse to push commits that carry the XPR global-optimum seeding study.
#
# The study is research material kept in its own repository (../xpr-seeding-study,
# extracted 2026-09-04). Its one commit was dropped from this history on 2026-11-20
# (handoff/10-fix-list.md A0.6), before the public fork coolguykerr/XModFit was made.
# This hook keeps it from coming back, on any remote: origin (the fork) or upstream
# (chemmatcars/XModFit, which must never be pushed to at all).
#
# Install with:  git config core.hooksPath .githooks
# Override once: ALLOW_STUDY_PUSH=1 git push ...
#
# Hooks are not shared by clone, so this protects THIS working copy only.

PATTERN='^(julia/bakeoff/|handoff/seeding-study/|SEEDING_STUDY_TIM1\.md|STAGE2_SEEDING_PLAN\.md|TIM1_SEEDING_REPORT\.md|PLAN_XMODFIT_FASTSCAN\.md|PLAN_CLUSTER_TOOL\.md)'
ZERO='0000000000000000000000000000000000000000'

# The original project is never pushed to; changes go upstream as pull requests.
case "$2" in
    *chemmatcars/XModFit*|*chemmatcars/xmodfit*)
        echo "pre-push: REFUSING to push to $2 (the upstream project)." >&2
        echo "Push to origin (the fork) and open a pull request instead." >&2
        exit 1 ;;
esac
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue          # branch deletion

    if [ "$remote_sha" = "$ZERO" ]; then            # new branch on the remote
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi

    # shellcheck disable=SC2086
    hits=$(git log --pretty=format: --name-only $range 2>/dev/null \
           | sort -u | grep -E "$PATTERN" || true)

    if [ -n "$hits" ]; then
        echo "pre-push: REFUSING to push $local_ref -> $remote_ref" >&2
        echo "" >&2
        echo "These commits carry the XPR seeding study, which must not reach" >&2
        echo "any GitHub repository. Offending paths:" >&2
        echo "$hits" | sed 's/^/    /' >&2
        echo "" >&2
        echo "The study lives in its own repository (../xpr-seeding-study). Remove" >&2
        echo "these paths from the commits before pushing (see" >&2
        echo "handoff/10-fix-list.md A0.6)." >&2
        echo "" >&2
        echo "To override deliberately: ALLOW_STUDY_PUSH=1 git push ..." >&2
        status=1
    fi
done

if [ "$status" -ne 0 ] && [ -n "$ALLOW_STUDY_PUSH" ]; then
    echo "pre-push: ALLOW_STUDY_PUSH set -- proceeding anyway." >&2
    status=0
fi

exit $status
