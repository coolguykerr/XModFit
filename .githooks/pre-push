#!/bin/sh
# Refuse to push commits that carry the XPR global-optimum seeding study.
#
# In this repository `origin` is chemmatcars/XModFit -- the UPSTREAM project, not a
# personal fork -- so a careless push publishes research material into someone else's
# repo. The study was extracted to its own repository (../xpr-seeding-study) on
# 2026-09-04; see handoff/10-fix-list.md A0.6.
#
# Install with:  git config core.hooksPath .githooks
# Override once: ALLOW_STUDY_PUSH=1 git push ...
#
# Hooks are not shared by clone, so this protects THIS working copy only. The durable
# protection is that the study is no longer in the tree.

PATTERN='^(julia/bakeoff/|handoff/seeding-study/|SEEDING_STUDY_TIM1\.md|STAGE2_SEEDING_PLAN\.md|TIM1_SEEDING_REPORT\.md|PLAN_XMODFIT_FASTSCAN\.md|PLAN_CLUSTER_TOOL\.md)'
ZERO='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue          # branch deletion

    if [ "$remote_sha" = "$ZERO" ]; then            # new branch on the remote
        range="$local_sha --not --remotes=origin"
    else
        range="$remote_sha..$local_sha"
    fi

    # shellcheck disable=SC2086
    hits=$(git log --pretty=format: --name-only $range 2>/dev/null \
           | sort -u | grep -E "$PATTERN" || true)

    if [ -n "$hits" ]; then
        echo "pre-push: REFUSING to push $local_ref -> $remote_ref" >&2
        echo "" >&2
        echo "These commits carry the XPR seeding study, which must not reach" >&2
        echo "chemmatcars/XModFit. Offending paths:" >&2
        echo "$hits" | sed 's/^/    /' >&2
        echo "" >&2
        echo "The study lives in its own repository now. To get genuine XModFit work" >&2
        echo "upstream, push a curated branch that excludes commit 7942458 (see" >&2
        echo "handoff/10-fix-list.md A0.6), or drop that commit from this branch." >&2
        echo "" >&2
        echo "To override deliberately: ALLOW_STUDY_PUSH=1 git push ..." >&2
        status=1
    fi
done

if [ "$status" -ne 0 ] && [ -n "$ALLOW_STUDY_PUSH" ]; then
    echo "pre-push: ALLOW_STUDY_PUSH set -- proceeding anyway." >&2
    status=0
fi

exit $status
