# Byte-compiled / cache
__pycache__/
*.py[cod]

# MCMC backends and saved fit output -- testing artefacts, can reach hundreds of MB.
*.h5
*.xfit

# Unpublished structure, removed from the repo deliberately. Kept out so it cannot
# be re-added by accident; the shipped default template is Data/1ubq.pdb.
Data/tim3_hmmm_ext_all_bestframe.pdb

# Saved fit-parameter files are per-analysis testing output, not source. Genuine
# test fixtures belong in tests/fixtures/ instead (and are not ignored there).
Data/*.par
Data/*.xpar
Data/*.jpar

# Local scratch
.perr
mesh.txt

# Note: .idea/ is deliberately NOT ignored -- two files in it are tracked upstream.
# They are currently modified to encode one machine's conda path; see 10-fix-list.md A0.5.
