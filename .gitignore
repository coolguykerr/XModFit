# Byte-compiled / cache
__pycache__/
*.py[cod]

# MCMC backends and saved fit output -- testing artefacts, can reach hundreds of MB.
*.h5
*.xfit

# Structures stay on the local disk but none are shipped: users get ONE example
# template, Data/1ubq.pdb. Nd9/Pr4 are upstream's and already tracked. Anything else
# needs a deliberate `git add -f` and a reason.
Data/*.pdb
!Data/1ubq.pdb
!Data/Nd9.pdb
!Data/Pr4.pdb

# Saved fit-parameter files are per-analysis testing output, not source. Genuine
# test fixtures belong in tests/fixtures/ instead (and are not ignored there).
Data/*.par
Data/*.xpar
Data/*.jpar

# XPR global-optimum seeding study -- research, not an XModFit feature. Extracted to
# its own repository (../xpr-seeding-study) on 2026-09-04. Ignored here so it cannot
# drift back in; commit 7942458 still has the tracked half, see 10-fix-list.md A0.6.
/julia/bakeoff/
/handoff/seeding-study/
/SEEDING_STUDY_TIM1.md
/STAGE2_SEEDING_PLAN.md
/TIM1_SEEDING_REPORT.md
/PLAN_XMODFIT_FASTSCAN.md
/PLAN_CLUSTER_TOOL.md

# Local scratch
.perr
mesh.txt

# Note: .idea/ is deliberately NOT ignored -- two files in it are tracked upstream.
# They are currently modified to encode one machine's conda path; see 10-fix-list.md A0.5.
tests/_logs/

# Agent review / audit output (WS0/WS1 audit 2026-11-09, item N5). Kept on disk,
# never committed by accident.
.superpowers/
